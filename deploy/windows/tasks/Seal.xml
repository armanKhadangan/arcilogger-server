<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>ARCILOGGER</Author>
    <Description>Mühürleme: kapanan günleri sıkıştırır, özetler, zincirler, Kamu SM zaman damgası alır ve doğrular. 00:10'dan itibaren 5 dakikada bir; bekleyen gün yoksa hemen biter. Web arayüzündeki "Şimdi mühürle" de bu görevi uyandırır (olay 4110, ARCILOGGER-Admin).</Description>
    <URI>\ARCILOGGER\Seal</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- "Şimdi mühürle" (seal now): ArciAdmin writes a signed seal request and then Event 4110;
         the event only wakes the task, the signed request is the authority (ADR-0014). A run
         already in progress ignores the wake-up (IgnoreNew): the next 5-minute run takes it. -->
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Application"&gt;&lt;Select Path="Application"&gt;*[System[Provider[@Name='ARCILOGGER-Admin'] and EventID=4110]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
    <CalendarTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>P1D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:10:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <!-- LOCAL SERVICE: no password to store; gets only the folder rights the installer grants. -->
    <Principal id="Author">
      <UserId>S-1-5-19</UserId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- Run as soon as possible after a missed start (systemd Persistent=true). -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{PYTHON}}</Command>
      <Arguments>-I -m arcilogger_core seal</Arguments>
    </Exec>
  </Actions>
</Task>
