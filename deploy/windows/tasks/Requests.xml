<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>ARCILOGGER</Author>
    <Description>Web arayüzünden istenen işler: kontör sorgusu, damga testi, replika testi. Yönetim hizmetinin imzaladığı istekleri en eskisinden başlayarak çalıştırır ve sonucunu yazar; istek yoksa hemen biter. Olay 4111 (ARCILOGGER-Admin) ile uyanır, ayrıca 5 dakikada bir denetler.</Description>
    <URI>\ARCILOGGER\Requests</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- ArciAdmin writes a signed task request and then Event 4111; the event only wakes the
         task, the signed request is the authority (ADR-0014). -->
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Application"&gt;&lt;Select Path="Application"&gt;*[System[Provider[@Name='ARCILOGGER-Admin'] and EventID=4111]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
    <!-- Safety net for a lost wake-up: every 5 minutes, all day. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>P1D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <!-- LOCAL SERVICE, as every evidence job: the credit query and the time-stamp test run with
         the same identity and rights as the nightly Credit and Seal tasks. -->
    <Principal id="Author">
      <UserId>S-1-5-19</UserId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- A wake-up during a run queues one more run: requests are never missed, runs never overlap. -->
    <MultipleInstancesPolicy>Queue</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- Run as soon as possible after a missed start (systemd Persistent=true). -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- The agent reports a request without a result after 15 minutes as timed out. -->
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{PYTHON}}</Command>
      <Arguments>-I -m arcilogger_core requests run</Arguments>
    </Exec>
  </Actions>
</Task>
