<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows service ArciIngest (WinSW 2.12 configuration, see doc/xmlConfigFile.md of v2.12.0).
  Install-Arcilogger.ps1 fills in the {{...}} values and runs it as NT SERVICE\ArciIngest.
  No hard dependency on the PostgreSQL service: when the database is down, ingest stops advancing
  its spool offset and catches up later (ADR-0002), so it must not be stopped together with it.
-->
<service>
  <id>ArciIngest</id>
  <name>ARCILOGGER Aktarım (Ingest)</name>
  <description>Ham dosyaları izler, ayrıştırır ve veritabanına yükler. [Tails the raw spool, parses it and loads PostgreSQL.]</description>
  <!-- Isolated Python (-I): no PYTHON* variable of the machine or of this service (registry
       Services\ArciIngest\Environment) can put a module on the path; -X utf8 -u replace
       PYTHONUTF8 and PYTHONUNBUFFERED, which -I ignores. -->
  <executable>{{INSTALL_DIR}}\venv\Scripts\python.exe</executable>
  <arguments>-I -X utf8 -u -m arcilogger_ingest run --config "{{CONFIG}}"</arguments>
  <env name="ARCILOGGER_CONFIG" value="{{CONFIG}}"/>
  <startmode>Automatic</startmode>
  <!-- Delayed: PostgreSQL usually runs by then; ingest retries on its own anyway. -->
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
