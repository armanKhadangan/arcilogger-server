<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows service ArciCollector (WinSW 2.12 configuration, see doc/xmlConfigFile.md of v2.12.0).
  Install-Arcilogger.ps1 fills in the {{...}} values, copies WinSW.NET461.exe next to this file as
  ArciCollector.exe and then runs the service under its virtual account NT SERVICE\ArciCollector
  (sc.exe config obj=; WinSW 2.12 documents no option for virtual accounts).
-->
<service>
  <id>ArciCollector</id>
  <name>ARCILOGGER Toplayıcı (Collector)</name>
  <description>Syslog alır (UDP/TCP 514) ve her mesajı önce değiştirmeden ham dosyaya yazar. [Receives syslog and writes every message unchanged to the raw spool first.]</description>
  <!-- Isolated Python (-I): no PYTHON* variable of the machine or of this service (registry
       Services\ArciCollector\Environment) can put a module on the path; -X utf8 -u replace
       PYTHONUTF8 and PYTHONUNBUFFERED, which -I ignores. -->
  <executable>{{INSTALL_DIR}}\venv\Scripts\python.exe</executable>
  <arguments>-I -X utf8 -u -m arcilogger_collector run --config "{{CONFIG}}"</arguments>
  <env name="ARCILOGGER_CONFIG" value="{{CONFIG}}"/>
  <!-- Starts right after boot (not delayed): log messages arrive whether or not anyone is ready. -->
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <!-- Ctrl+C first: the collector flushes and closes the spool files before it exits. -->
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
