<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows service ArciApi (WinSW 2.12 configuration, see doc/xmlConfigFile.md of v2.12.0).
  Install-Arcilogger.ps1 fills in the {{...}} values and runs it as NT SERVICE\ArciApi.
  The API listens on 127.0.0.1:8000 only; Caddy (ArciWeb) is the only thing in front of it.
-->
<service>
  <id>ArciApi</id>
  <name>ARCILOGGER API</name>
  <description>Web arayüzünün HTTP API'si; yalnızca 127.0.0.1:8000 adresinde dinler. [HTTP API behind the web interface, 127.0.0.1:8000 only.]</description>
  <!-- Isolated Python (-I): no PYTHON* variable of the machine or of this service (registry
       Services\ArciApi\Environment) can put a module on the path; -X utf8 -u replace
       PYTHONUTF8 and PYTHONUNBUFFERED, which -I ignores. -->
  <executable>{{INSTALL_DIR}}\venv\Scripts\python.exe</executable>
  <arguments>-I -X utf8 -u -m arcilogger_api serve --config "{{CONFIG}}"</arguments>
  <env name="ARCILOGGER_CONFIG" value="{{CONFIG}}"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
