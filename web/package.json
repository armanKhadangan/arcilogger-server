{
  "name": "arcilogger-web",
  "private": true,
  "version": "0.1.0",
  "description": "ARCILOGGER web interface (served by the ARCILOGGER server; no client software is installed on user PCs)",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "i18next": "25.10.10",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.21.0",
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
